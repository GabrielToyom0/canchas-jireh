# Copie este archivo como backend/.env para desarrollo local (npm run dev).

PORT=3000
DATABASE_URL=sqlserver://localhost:1433;database=CanchasJirehDB;user=sa;password=Cambiar_Esta_Clave1;trustServerCertificate=true

# Seguridad (RNF-01)
JWT_ACCESS_SECRET=desarrollo-jwt-secreto-cambiar-en-produccion
JWT_ACCESS_TTL=15m
REFRESH_TTL_DIAS=7
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
LIMITE_GENERAL=600
LIMITE_AUTH=20

# Cuenta del propietario que se crea al arrancar si no existe
PROPIETARIO_CORREO=propietario@canchasjireh.gt
PROPIETARIO_PASSWORD=Propietario2026

# Reglas de negocio
RESERVA_EXPIRA_MIN=15
RECORDATORIO_HORAS=24
MAX_DIAS_ANTICIPACION=60
TAREAS_INTERVALO_MS=30000

# Comprobantes de transferencia
UPLOADS_DIR=./uploads
MAX_COMPROBANTE_MB=5

# Correo (Mailpit en desarrollo: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
CORREO_REMITENTE=Canchas Jireh <no-responder@canchasjireh.gt>
APP_URL=http://localhost:5173

# Copie este archivo como .env en la raíz (lo usa docker compose).
# En producción cambie TODOS los valores secretos.

MSSQL_SA_PASSWORD=Cambiar_Esta_Clave1
JWT_ACCESS_SECRET=desarrollo-jwt-secreto-cambiar-en-produccion

# Cuenta del propietario que se crea la primera vez
PROPIETARIO_CORREO=propietario@canchasjireh.gt
PROPIETARIO_PASSWORD=Propietario2026

# Dirección pública del sitio (CORS y enlaces de los correos)
APP_URL=http://localhost:8080
# true cuando el sitio se sirve con HTTPS
COOKIE_SECURE=false

# Intentos de login/registro por IP cada 15 min (súbalo para correr las pruebas E2E)
LIMITE_AUTH=20

# SMTP real (en local se usa Mailpit)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
